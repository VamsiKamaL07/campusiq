# ---------- Backend ----------
ENVIRONMENT=development            # development | production
DATABASE_URL=postgresql+psycopg://campusiq:campusiq@localhost:5432/campusiq
CORS_ORIGINS=http://localhost:5173
# AUTH_MODE=firebase verifies real Firebase ID tokens.
# AUTH_MODE=dev accepts "dev:<email>" tokens. The app REFUSES to start with dev auth when ENVIRONMENT=production.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=    # path to Firebase service-account JSON (never commit)
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# One-time bootstrap: email that is created as the first super admin by `python -m app.scripts.bootstrap`
BOOTSTRAP_ADMIN_EMAIL=

# ---------- Frontend (public values only; no secrets here) ----------
VITE_API_URL=http://localhost:8000/api/v1
VITE_AUTH_MODE=dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
